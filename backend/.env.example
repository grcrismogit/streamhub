# =============================================================
#  StreamHub API — variables de entorno
#  Copia este archivo a .env (local) o a /etc/streamhub/api.env (EC2)
#  ¡NUNCA subas el archivo real a Git!
# =============================================================
ENVIRONMENT=production
LOG_LEVEL=INFO

# URL pública del frontend (bucket S3 con hosting estático). Separar con comas.
CORS_ORIGINS=http://streamhub-frontend-XXXX.s3-website-us-east-1.amazonaws.com,http://localhost:5173

# ---------- Amazon RDS (PostgreSQL) ----------
DB_HOST=streamhub-db.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=streamhub
DB_USER=streamhub_admin
DB_PASSWORD=cambia-esto
DB_SSLMODE=require

# ---------- JWT ----------
# Generar con:  python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=genera-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------- Amazon S3 ----------
# ¡NO pongas AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY aquí! En EC2 se usa el IAM Role.
# (Solo en desarrollo local con el emulador: S3_ENDPOINT_URL=http://localhost:5000 y keys = local)
AWS_REGION=us-east-1
S3_VIDEOS_BUCKET=streamhub-videos-XXXX
S3_THUMBNAILS_BUCKET=streamhub-thumbnails-XXXX
S3_PRESIGNED_EXPIRE_SECONDS=3600

MAX_VIDEO_SIZE_MB=100
MAX_THUMBNAIL_SIZE_MB=5
