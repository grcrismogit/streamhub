# /etc/systemd/system/streamhub-api.service
# Servicio systemd: arranca la API al iniciar la instancia y la reinicia si falla.
[Unit]
Description=StreamHub API (FastAPI + Uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=streamhub
Group=streamhub
WorkingDirectory=/opt/streamhub/backend
# Variables de entorno (RDS, S3, JWT...). Archivo con permisos 600, fuera del repositorio.
EnvironmentFile=/etc/streamhub/api.env
ExecStart=/opt/streamhub/backend/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port 8000 \
    --workers 2 \
    --proxy-headers --forwarded-allow-ips 127.0.0.1 \
    --no-server-header
Restart=always
RestartSec=3

# Endurecimiento (hardening) básico
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
