{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StreamHubMediaObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::streamhub-videos-XXXX/*",
        "arn:aws:s3:::streamhub-thumbnails-XXXX/*"
      ]
    }
  ]
}
